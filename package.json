{
  "name": "my-little-artist",
  "productName": "My Little Artist",
  "version": "1.0.0",
  "description": "My Little Artist - un programa de dibujo tipo Paint, colorido y fácil para niños.",
  "main": "main.js",
  "author": "Nery Barillas",
  "homepage": "https://github.com/NBARILLAS28/my-little-artist",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/make-web.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist": "electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nerybarillas.mylittleartist",
    "productName": "My Little Artist",
    "copyright": "Copyright © 2026 My Little Artist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "minimumSystemVersion": "11.0.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "My-Little-Artist-${version}-Mac.${ext}"
    },
    "dmg": {
      "title": "My Little Artist",
      "background": "build/dmg-background.png",
      "iconSize": 110,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 160,
          "y": 215,
          "type": "file"
        },
        {
          "x": 440,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "My-Little-Artist-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Little Artist",
      "language": "1034"
    }
  }
}
